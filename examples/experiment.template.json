{
  "schema": "benchinterlace.spec.v1",
  "workload": "Replace illustrative paths before planning",
  "cwd": "/absolute/workload-directory",
  "commands": {
    "A": {"argv": ["/absolute/old-program", "input.txt"]},
    "B": {"argv": ["/absolute/new-program", "input.txt"]}
